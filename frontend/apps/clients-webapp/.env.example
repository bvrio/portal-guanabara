# Copy to .env to override runtime config locally.

# Base URL of the App's own API (server/api: the Catalog). Default: /api.
# NUXT_PUBLIC_API_BASE_URL=/api

# The demo Authentication and User Journeys talk to a local mock backend.
# There is no BFF (BVRio, November 2026); turn the mock off in production.
# NUXT_MOCK_BFF_ENABLED=false
# NUXT_PUBLIC_MOCK_BFF_BASE_URL=/mock-bff

# Feature Flags (temporary rollout controls) — see src/shared/hooks/feature-flag.
# NUXT_PUBLIC_FEATURE_FLAGS_HOME_GUIDED_TOUR=true
# Person names in the Catalog (on in development, off by default in builds,
# until BVRio answers the LGPD question).
# NUXT_PUBLIC_FEATURE_FLAGS_CATALOG_PERSON_NAMES=false
